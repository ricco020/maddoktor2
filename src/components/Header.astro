---
import { ui, localized, categories, catLabel } from '../lib/ui';
interface Props { lang?: string; alternates?: { lang: string; href: string }[]; }
const { lang = 'en', alternates = [] } = Astro.props;
const t = ui[lang] || ui.en;
const prefix = lang === 'en' ? '' : `/${lang}`;

// Catbar: "All guides" + each category. Slugs identical across locales.
const cats = [
  { l: t.all_guides, h: '/articles/' },
  ...categories.map((c) => ({ l: catLabel(c, lang), h: `/c/${c.slug}/` })),
];

const path = Astro.url.pathname;
const stripLocale = (p: string) => p.replace(/^\/(fr|es|de|it|pt)\//, '/').replace(/^\/(fr|es|de|it|pt)$/, '/');
const basePath = stripLocale(path);
const cur = path.replace(/\/$/, '');

// Le selecteur de langue ne peut PAS se contenter d echanger le prefixe de
// locale: les slugs d articles sont localises (how-to-remove-adware en anglais,
// adware-entfernen en allemand), donc /articles/adware-entfernen/ n existe pas.
// C est exactement l avertissement deja ecrit dans Article.astro pour les
// hreflang, qui n avait jamais ete applique ici.
//
// Mesure du 2026-08-04: sur 60 pages lues, 206 liens du selecteur pointaient
// vers des 404, TOUS depuis les pages /de/. Le composant etant present sur
// toutes les pages du site, la portee reelle depassait l echantillon.
//
// Correctif: on consomme les alternates deja resolus par translationKey pour
// les hreflang, qui sont la seule source exacte. On ne retombe sur l echange
// de prefixe que si aucun alternate n est fourni, ce qui est le cas des pages
// statiques (/about/, /charter/), dont le chemin est bien identique partout.
const byLang = new Map(alternates.map((a) => [a.lang, a.href]));
const swap = (code: string) =>
  code === 'en' ? basePath : `/${code}${basePath === '/' ? '/' : basePath}`;
const LANGS = [['en', 'EN'], ['fr', 'FR'], ['es', 'ES'], ['de', 'DE'], ['it', 'IT'], ['pt', 'PT']];
const langLinks = LANGS.map(([code, label]) => ({
  code,
  label,
  href: byLang.get(code) ?? swap(code),
  // Une locale sans traduction reelle n a pas d alternate. La lister quand
  // meme enverrait le lecteur sur un 404; on la desactive visuellement plutot
  // que de la masquer, pour ne pas faire varier la navigation d une page a
  // l autre.
  missing: alternates.length > 0 && !byLang.has(code),
}));
---
<header class="topbar">
  <div class="wrap row">
    <a class="brand" href={`${prefix}/`} aria-label="MadDoktor2 - home"><span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h4l2-6 4 12 2-6h8"/></svg></span>MadDoktor</a>
    <nav class="top">
      <a href={`${prefix}/articles/`}>{t.nav_guides}</a>
      <a href={`${prefix}/file-hash-checker/`}>{t.nav_tools}</a>
      <a href={`${prefix}/charter/`}>{t.nav_charter}</a>
      <a href={`${prefix}/heritage/`}>{t.nav_heritage}</a>
      <a href={`${prefix}/about/`}>{t.nav_about}</a>
    </nav>
    <div class="langsw" aria-label="Language">
      {langLinks.map((l) => (
        l.missing
          ? <span class="off" aria-disabled="true">{l.label}</span>
          : <a href={l.href} aria-current={lang === l.code ? 'true' : undefined} class:list={[lang === l.code && 'on']}>{l.label}</a>
      ))}
    </div>
    <form class="search" role="search" action={localized('/search/', lang)} method="get">
      <span aria-hidden="true">🔍</span>
      <input type="search" name="q" placeholder={t.search_ph} aria-label={t.search_ph} />
    </form>
  </div>
</header>
<div class="catbar">
  <div class="wrap row">
    {cats.map((c) => <a class:list={['cat', cur === localized(c.h, lang).replace(/\/$/, '') && 'on']} href={localized(c.h, lang)}>{c.l}</a>)}
  </div>
</div>
